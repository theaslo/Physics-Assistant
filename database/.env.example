# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=physics_assistant
POSTGRES_USER=physics_user
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_PASSWORD
POSTGRES_SSL_MODE=prefer

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_PASSWORD

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_PASSWORD
NEO4J_HTTP_PORT=7474

# Database Connection Pool Settings
DB_POOL_MIN_CONNECTIONS=5
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=600000

# Application Settings
DATABASE_URL=postgresql://local_user:REPLACE_WITH_A_UNIQUE_LOCAL_PASSWORD@localhost:5432/physics_assistant
REDIS_URL=redis://:redis_secure_password_2024@localhost:6379

# Development Settings
DB_DEBUG_LOG=false
DB_SYNC_FORCE=false

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Security Settings
SESSION_SECRET=REPLACE_WITH_A_GENERATED_LOCAL_SECRET
JWT_SECRET=REPLACE_WITH_A_GENERATED_LOCAL_SECRET
ENCRYPTION_KEY=your_encryption_key_here_change_in_production